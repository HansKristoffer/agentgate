<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  scripts/desktop-build.ts signs the daemon inside Agentgate.app with this file.

  The daemon is a compiled Bun binary. Under the hardened runtime that
  notarization requires, JavaScriptCore is refused executable memory without
  allow-jit and falls back to its interpreter: measured 50 times slower.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
