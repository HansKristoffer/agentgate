{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentgate",
  "version": "0.14.0",
  "identifier": "dev.agentgate.desktop",
  "build": {
    "beforeDevCommand": "bun ../../scripts/desktop-prepare.ts && bunx vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun ../../scripts/desktop-prepare.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agentgate",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/agentgate"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4REFGQjE4M0Y1ODBFODMKUldTRERsZy9HUHZhYUkzN2gxK2R2aGR5aWl6RkplY0RBVmY4Ymd2dkJpQTlINm4rU0k4ZmhQd1kK",
      "endpoints": [
        "https://github.com/HansKristoffer/agentgate/releases/latest/download/latest.json"
      ]
    }
  }
}
