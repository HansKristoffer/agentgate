{
  "name": "agentgate-desktop",
  "title": "Agentgate",
  "id": "dev.agentgate.desktop",
  "version": "0.17.1",
  "size": "1120x760",
  "icon": "icon.png",
  "backend": "src/main.ts",
  "frontend": {
    "build": "bun run build",
    "dist": "dist",
    "dev": "bun ../../scripts/desktop-prepare.ts && bunx vite",
    "devUrl": "http://127.0.0.1:1420"
  },
  "chrome": {
    "frame": false,
    "transparent": true,
    "vibrancy": "underwindow",
    "windowControlsPos": { "x": 20, "y": 30 }
  },
  "update": {
    "url": "https://github.com/HansKristoffer/agentgate/releases/latest/download/desktop-update.json"
  }
}
