{
  "name": "agentgate",
  "version": "0.17.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun run --filter @agentgate/daemon start",
    "cli": "bun apps/agentgate/src/cli.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && bunx tsc --noEmit -p tsconfig.json",
    "build": "bun scripts/build.ts",
    "build:desktop": "bun scripts/desktop-build.ts",
    "build:frontend": "bun run --filter @agentgate/desktop build",
    "build:site": "bun run --filter @agentgate/site build",
    "seed-dev-store": "bun scripts/seed-dev-store.ts"
  },
  "packageManager": "bun@1.4.2"
}
