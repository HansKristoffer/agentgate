{
  "name": "agentgate",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun run --filter @agentgate/desktop dev",
    "start": "bun run --filter @agentgate/daemon start",
    "cli": "bun apps/agentgate/src/cli.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && bunx tsc --noEmit -p tsconfig.json",
    "build": "bun scripts/build.ts",
    "build:desktop": "bun run --filter @agentgate/desktop bundle",
    "build:frontend": "bun run --filter @agentgate/desktop build",
    "build:site": "bun run --filter @agentgate/site build",
    "check:native": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "packageManager": "bun@1.4.2"
}
