{
  "name": "agentgate",
  "version": "0.39.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun run --filter @agentgate/daemon start",
    "cli": "bun apps/agentgate/src/cli.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && bun check --no-script -p tsconfig.json",
    "fmt": "bun fmt --no-script .",
    "fmt:check": "bun fmt --no-script --check .",
    "check": "bun run typecheck && bun run fmt:check && bun test && bun run check:native",
    "build": "bun scripts/build.ts",
    "build:desktop": "bun run --filter @agentgate/desktop bundle",
    "build:frontend": "bun run --filter @agentgate/desktop build",
    "build:site": "bun run --filter @agentgate/site build",
    "check:native": "bun scripts/check-native.ts",
    "prepare": "bun scripts/install-hooks.ts",
    "seed-dev-store": "bun scripts/seed-dev-store.ts"
  },
  "packageManager": "bun@1.4.4"
}
